package components

import (
	"fmt"
	"todo-demo/internal/database/sqlc"
)

func priorityColor(priority string) string {
	switch priority {
	case "urgent":
		return "bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200"
	case "high":
		return "bg-orange-100 text-orange-800 dark:bg-orange-900 dark:text-orange-200"
	case "medium":
		return "bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200"
	default:
		return "bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-200"
	}
}

templ TaskCard(task sqlc.Task) {
	<div
		id={ fmt.Sprintf("task-%d", task.ID) }
		class="task-card cursor-grab rounded-lg bg-white p-4 shadow-sm transition hover:shadow-md dark:bg-gray-700"
		data-task-id={ fmt.Sprintf("%d", task.ID) }
		data-position={ fmt.Sprintf("%f", task.Position) }
	>
		<div class="mb-2 flex items-start justify-between gap-2">
			<span class={ "inline-block rounded-full px-2 py-0.5 text-xs font-medium", priorityColor(task.Priority) }>
				{ task.Priority }
			</span>
			<div class="flex gap-1">
				<button
					hx-post={ fmt.Sprintf("/tasks/%d/duplicate", task.ID) }
					hx-swap="none"
					class="rounded p-1 text-gray-400 hover:bg-indigo-50 hover:text-indigo-600 dark:hover:bg-indigo-900/50 dark:hover:text-indigo-300"
					title="Duplicate task"
				>
					@templ.Raw(`<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M4 4a2 2 0 012-2h6a2 2 0 012 2v1h-2V4H6v8h1v2H6a2 2 0 01-2-2V4z"/><path d="M9 8a2 2 0 012-2h5a2 2 0 012 2v8a2 2 0 01-2 2h-5a2 2 0 01-2-2V8zm2 0h5v8h-5V8z"/></svg>`)
				</button>
				<button
					hx-get={ fmt.Sprintf("/tasks/%d/edit", task.ID) }
					hx-target="#modal-container"
					hx-swap="innerHTML"
					class="rounded p-1 text-gray-400 hover:bg-gray-100 hover:text-gray-600 dark:hover:bg-gray-600 dark:hover:text-gray-200"
				>
					@templ.Raw(`<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z"/></svg>`)
				</button>
				<button
					hx-delete={ fmt.Sprintf("/tasks/%d", task.ID) }
					hx-target={ fmt.Sprintf("#task-%d", task.ID) }
					hx-swap="outerHTML"
					hx-confirm="Are you sure you want to delete this task?"
					class="rounded p-1 text-gray-400 hover:bg-red-50 hover:text-red-600 dark:hover:bg-red-900/50 dark:hover:text-red-400"
				>
					@templ.Raw(`<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>`)
				</button>
			</div>
		</div>
		<h3 class="mb-1 font-medium text-gray-900 dark:text-white">{ task.Title }</h3>
		if task.Description != "" {
			<p class="mb-2 line-clamp-2 text-sm text-gray-500 dark:text-gray-400">
				{ task.Description }
			</p>
		}
		if task.DueDate.Valid {
			<div class="mt-2 flex items-center gap-1 text-xs text-gray-400 dark:text-gray-500">
				@templ.Raw(`<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/></svg>`)
				<span>{ task.DueDate.String }</span>
			</div>
		}
	</div>
}
