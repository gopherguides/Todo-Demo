package pages

import (
	"todo-demo/internal/meta"
	"todo-demo/templates/layouts"
)

templ SignUp(page meta.Page, site meta.SiteConfig) {
	@layouts.Base(page, site) {
		<div class="flex min-h-full items-center justify-center py-12">
			<div id="sign-up"></div>
		</div>
		<script>
			(async function() {
				var key = document.querySelector('meta[name="clerk-publishable-key"]').content;
				var clerk = new window.Clerk(key);
				await clerk.load();
				clerk.mountSignUp(document.getElementById('sign-up'));
			})();
		</script>
	}
}
